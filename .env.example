# Development defaults to ./data. Windows production should set this to:
# %LOCALAPPDATA%\PaymentLedger
PAYMENT_LEDGER_DATA_DIR=
PAYMENT_LEDGER_LOG_LEVEL=warn

# Muse AI direct-access surface (empty = feature disabled entirely)
# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MUSE_API_KEY=

# Optional private Telegram companion
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_SUMMARY_TIMES=18:00,20:00
TELEGRAM_TIME_ZONE=Asia/Kolkata
TELEGRAM_FORWARD_INTERVAL_MS=15000
